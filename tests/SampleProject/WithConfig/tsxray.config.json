{
  "rules": {
    "no-large-functions": {
      "enabled": true,
      "options": {
        "maxLines": 5
      }
    },
    "no-deep-nesting": {
      "enabled": true,
      "options": {
        "maxDepth": 2,
        "excludedConstructs": ["try", "callback"]
      }
    },
    "god-module": {
      "options": {
        "requiredSignals": 3,
        "size": {
          "enabled": true,
          "maxLines": 15,
          "maxDeclarations": 3,
          "maxFunctionsAndClasses": 3,
          "maxExports": 3,
          "requiredMetrics": 2
        },
        "dependencies": {
          "enabled": true,
          "maxCount": 2
        },
        "dependents": {
          "enabled": true,
          "maxCount": 1
        }
      }
    },
    "no-unused-files": {
      "options": {
        "entryPoints": ["configured-root.ts", "hub.ts"],
        "excludedFiles": ["configured-generated.ts"]
      }
    },
    "no-unused-vars": {
      "options": {
        "args": "all",
        "varsIgnorePattern": "^ignored"
      }
    },
    "naming-quality": {
      "options": {
        "negativeBoolean": false,
        "booleanFunction": false,
        "valueFunctions": false,
        "booleanNames": ["permitted"],
        "vagueNames": false,
        "genericParameterNames": ["payload"],
        "typeSuffixes": false,
        "abbreviations": true,
        "acceptedAbbreviations": ["cfg"],
        "eventHandlers": true,
        "eventHandlerPatterns": ["^on[A-Z]"],
        "collectionNames": false,
        "callbackParameterMaxLines": 2
      }
    }
  }
}
