{
  "name": "tsxray",
  "version": "0.1.0",
  "description": "TypeScript code analysis",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "tsxray": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "scan": "npm run build && node dist/cli/index.js scan",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "dev": "tsx src/cli/index.ts",
    "publish": "npm run build && npm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "ts-morph": "^20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
